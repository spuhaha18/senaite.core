msgstr "비밀번호가 올바르지 않습니다. 실패한 시도가 기록되었습니다."

msgid "Signed electronically by ${name}"
msgstr "${name} 님이 전자서명하였습니다"

msgid "User ${user} has been unlocked"
msgstr "사용자 ${user}의 서명 잠금이 해제되었습니다"

